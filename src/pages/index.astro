---
// The home page lives at /teletext/100/. This page only redirects, and keeps
// links from the old version of the site (/?p=110) working.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Josep de Cid</title>
    <link rel="canonical" href="https://josepdecid.com/teletext/100/" />
    <script is:inline>
      const code = new URLSearchParams(location.search).get("p");
      location.replace(/^\d{3}$/.test(code ?? "") ? `/teletext/${code}/` : "/teletext/100/");
    </script>
    <meta http-equiv="refresh" content="0; url=/teletext/100/" />
  </head>
  <body>
    <a href="/teletext/100/">Go to the home page</a>
  </body>
</html>
