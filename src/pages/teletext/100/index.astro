---
import FooterNav from "../../../components/FooterNav.astro";
import MenuColumn from "../../../components/MenuColumn.astro";
import TitleBar from "../../../components/TitleBar.astro";
import { contactInfo, home, sections } from "../../../data/menu";
import Teletext from "../../../layouts/Teletext.astro";

const { profile, projects, content, connect } = sections;
---

<Teletext code="100">
  <TitleBar title="JOSEP'S PORTFOLIO" />

  <div class="navigation-menu-section">
    <MenuColumn {...profile} />
    <MenuColumn {...projects} />
  </div>

  <MenuColumn entries={[home]} background="blue" foreground="white" bar />

  <div class="navigation-menu-section">
    <MenuColumn {...content} />
    <MenuColumn {...connect} />
  </div>

  <MenuColumn entries={[contactInfo]} background="white" foreground="red" bar />

  <FooterNav />
</Teletext>
